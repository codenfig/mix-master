# MixMaster AI generated file storage
#
# Files are stored outside the Git checkout by default:
#   ~/MixMasterAI/Storage
# Set these variables in your shell before starting uvicorn.
#
# Development:
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=~/MixMasterAI/Storage
# Optional SQLite path (defaults to <STORAGE_LOCAL_ROOT>/metadata/files.sqlite3)
# STORAGE_METADATA_DB=~/MixMasterAI/Storage/metadata/files.sqlite3
#
# Production: install boto3 and configure AWS credentials using IAM or
# standard AWS environment variables. Never commit credentials.
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=your-private-bucket
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# STORAGE_METADATA_DB=/persistent/volume/mixmaster/files.sqlite3
#
# S3 mode requires a durable metadata database path and private bucket.
# For multiple backend replicas, migrate the metadata index to a shared DB.
